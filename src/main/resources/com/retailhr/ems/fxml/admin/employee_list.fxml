<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.retailhr.ems.controller.admin.EmployeeListController">

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="section-title" text="Employees"/>
        <TextField fx:id="searchField" promptText="Search by name or code" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" promptText="Status"/>
        <ComboBox fx:id="departmentFilter" promptText="Department"/>
        <Button fx:id="addEmployeeButton" onAction="#handleAddEmployee" styleClass="primary-button" text="+ Add Employee"/>
    </HBox>

    <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" text="Code" prefWidth="90.0"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0"/>
            <TableColumn fx:id="departmentColumn" text="Department" prefWidth="140.0"/>
            <TableColumn fx:id="positionColumn" text="Position" prefWidth="140.0"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0"/>
            <TableColumn fx:id="hiredColumn" text="Hired" prefWidth="100.0"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180.0"/>
        </columns>
    </TableView>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>