<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.retailhr.ems.controller.admin.AuditLogViewController">

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="section-title" text="Audit Log"/>
        <TextField fx:id="searchField" promptText="Search action or entity" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="entityFilter" promptText="Entity"/>
        <Button onAction="#handleRefresh" styleClass="secondary-button" text="Refresh"/>
    </HBox>

    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="150.0"/>
            <TableColumn fx:id="actorColumn" text="Actor" prefWidth="130.0"/>
            <TableColumn fx:id="actionColumn" text="Action" prefWidth="160.0"/>
            <TableColumn fx:id="entityColumn" text="Entity" prefWidth="120.0"/>
            <TableColumn fx:id="entityIdColumn" text="Entity ID" prefWidth="80.0"/>
            <TableColumn fx:id="detailsColumn" text="Details" prefWidth="260.0"/>
        </columns>
    </TableView>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>