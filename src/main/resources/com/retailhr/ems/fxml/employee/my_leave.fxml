<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.retailhr.ems.controller.employee.MyLeaveController">

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="section-title" text="My Leave Requests"/>
        <Button onAction="#handleNewRequest" styleClass="primary-button" text="+ Request Leave"/>
    </HBox>

    <TableView fx:id="leaveTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="leaveTypeColumn" text="Type" prefWidth="100.0"/>
            <TableColumn fx:id="startDateColumn" text="Start" prefWidth="110.0"/>
            <TableColumn fx:id="endDateColumn" text="End" prefWidth="110.0"/>
            <TableColumn fx:id="daysColumn" text="Days" prefWidth="60.0"/>
            <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="220.0"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0"/>
            <TableColumn fx:id="commentColumn" text="Admin Comment" prefWidth="200.0"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100.0"/>
        </columns>
    </TableView>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>