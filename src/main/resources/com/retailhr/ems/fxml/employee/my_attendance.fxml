<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.retailhr.ems.controller.employee.MyAttendanceController">

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="section-title" text="My Attendance"/>
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button onAction="#handleFilter" styleClass="secondary-button" text="Apply"/>
    </HBox>

    <HBox spacing="24.0" styleClass="summary-bar">
        <Label fx:id="daysPresentLabel" styleClass="summary-stat"/>
        <Label fx:id="totalHoursLabel" styleClass="summary-stat"/>
    </HBox>

    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0"/>
            <TableColumn fx:id="clockInColumn" text="Clock In" prefWidth="110.0"/>
            <TableColumn fx:id="clockOutColumn" text="Clock Out" prefWidth="110.0"/>
            <TableColumn fx:id="hoursColumn" text="Hours" prefWidth="90.0"/>
            <TableColumn fx:id="methodColumn" text="Method" prefWidth="90.0"/>
        </columns>
    </TableView>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>